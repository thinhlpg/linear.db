# Agentic PM Configuration

# Linear DB MCP Server URL
LINEAR_DB_URL=http://localhost:3335/mcp

# Team configuration
TEAM_KEY=AGT
TEAM_NAME=Agentic PM

# Worker polling interval (seconds)
POLL_INTERVAL=5

# Claude model (sonnet, opus, haiku)
CLAUDE_MODEL=sonnet

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-api-key-here

# Claude Code Agent Teams (experimental)
# Enables multiple Claude Code sessions to work in parallel
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
